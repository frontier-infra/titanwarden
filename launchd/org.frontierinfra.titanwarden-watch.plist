<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.frontierinfra.titanwarden-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.titanwarden/current/.venv/bin/python</string>
    <string>/Users/USERNAME/.titanwarden/current/scripts/watch.py</string>
    <string>--home</string>
    <string>/Users/USERNAME/.titanwarden</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.titanwarden/log/watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.titanwarden/log/watch.err.log</string>
</dict>
</plist>
